{
  "name": "henrique-multimarcas-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy",
    "db:schema:local": "wrangler d1 execute henrique-multimarcas-staging --local --file=schema.sql",
